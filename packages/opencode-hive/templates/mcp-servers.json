{
  "mcpServers": {
    "websearch": {
      "command": "npx",
      "args": ["-y", "exa-mcp-server"],
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      },
      "description": "Exa AI web search (requires API key)"
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "description": "Library documentation lookup"
    },
    "grep_app": {
      "command": "npx",
      "args": ["-y", "grep-mcp"],
      "description": "GitHub code search via grep.app"
    },
    "codegraph": {
      "command": "npx",
      "args": ["-y", "@colbymchenry/codegraph", "serve", "--mcp"],
      "description": "Pre-indexed code knowledge graph. The Hive plugin wires this automatically; for manual setups npx self-installs on first run."
    }
  }
}
